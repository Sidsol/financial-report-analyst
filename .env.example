# ---------------------------------------------------------------------------
# Financial Report Analyst — environment configuration template.
# Copy to `.env` and fill in real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Required: SEC EDGAR requires a real User-Agent containing a contact email.
# See https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Student Project (jonah.martinez@bellevuecollege.edu)"

# Which LLM provider to use for answer synthesis.
# One of: openai | github_models | azure_openai
LLM_PROVIDER=github_models

# --- OpenAI (or any OpenAI-compatible endpoint) -----------------------------
# Required when LLM_PROVIDER=openai
OPENAI_API_KEY=
# Any model identifier accepted by the endpoint. We route through OpenAILike
# so model-name validation is bypassed — internal / custom / preview model
# names work as long as the endpoint accepts them.
OPENAI_MODEL=gpt-4o-mini
# Override only if you're pointing at a non-public OpenAI-compatible endpoint
# (e.g. a custom proxy, an internal deployment, a local server like LM Studio).
OPENAI_BASE_URL=https://api.openai.com/v1
# Set to true for newer reasoning / preview models (o-series, gpt-5*, etc.)
# that require `max_completion_tokens` instead of `max_tokens`.
OPENAI_USE_COMPLETION_TOKENS=false

# --- GitHub Models ----------------------------------------------------------
# Required when LLM_PROVIDER=github_models
# Token needs the `models:read` scope. Create at
# https://github.com/settings/tokens (or use a fine-grained token).
GITHUB_TOKEN=
# Default endpoint as of 2025+. Override only if GitHub changes it.
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
# GitHub Models prefixes with the publisher namespace, e.g. openai/gpt-4o-mini,
# meta/llama-3.1-405b-instruct, mistral-ai/mistral-large-2407.
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# --- Azure OpenAI -----------------------------------------------------------
# Required when LLM_PROVIDER=azure_openai
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
